                <mxCell id="13" value="Context cancellation can’t interrupt Mutex.Lock(). A goroutine blocked on a mutex won’t notice cancellation until it acquires the lock and returns to user code.&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;--&amp;gt; ghost meal can happen&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="90" width="230" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="&lt;b&gt;&lt;u&gt;SHARED STATES (MUTEX PROTECTED)&lt;/u&gt;&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;• forks []sync.Mutex&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 14px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;• lastMealTime (mealMu)&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 14px;&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;• mealCount (&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 14px; background-color: transparent;&quot;&gt;mealMu&lt;/span&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;• printMutex (logMu)&lt;/span&gt;&lt;b&gt;&lt;u&gt;&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fillColor=#D5C4FF;strokeColor=#EDE8FF;" parent="1" vertex="1">
